#!/usr/bin/env bash
set -euo pipefail

# Copy shared agent roles from this best_practices checkout into a project, or
# check that the project's copies still match.
#
# Usage:
#   bin/sync-agents <project-dir> [--ref <git-ref>] [--roles "<role> <role> ..."]
#   bin/sync-agents --check <project-dir>
#
# The project records what it takes in .claude/agents/UPSTREAM:
#
#   source: mariusog/best_practices
#   ref: <full commit sha>
#   roles: lead-agent core-agent qa-agent
#
# Synced roles are never edited in the project. Project specifics for a role
# go in .claude/agent-context/<role>.md, and each synced role is composed from
# best_practices plus that file: keys in the context file's frontmatter (such as
# a project-specific `description`) replace the role's, everything else in the
# role is copied verbatim, and the context file's body is appended at the end.
# A role without a context file is copied byte for byte. Agents in
# .claude/agents/ that are not listed under `roles:` are the project's own and
# are left alone, as long as they don't reuse a shared role's name.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="mariusog/best_practices"
AGENTS_DIR=".claude/agents"
CONTEXT_DIR=".claude/agent-context"
# Top-level keys Claude Code reads from agent frontmatter. A line starting with
# any other word (e.g. `user:` inside a description's <example>) continues the
# key above it.
FRONTMATTER_KEYS="name description tools disallowedTools model color permissionMode skills hooks mcpServers memory effort maxTurns background isolation initialPrompt"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

usage() {
    sed -n '4,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 1
}

upstream_value() {
    sed -n "s/^$2: *//p" "$1" | head -1
}

roles_at() {
    git -C "$ROOT" ls-tree --name-only "$1" "$AGENTS_DIR/" | sed -n "s|^$AGENTS_DIR/\(.*\)\.md$|\1|p"
}

role_body() {
    git -C "$ROOT" show "$1:$AGENTS_DIR/$2.md"
}

# Prints a role file's frontmatter (without its --- fences) or its body.
part() {
    awk -v want="$1" '
        NR == 1 && $0 == "---" { infront = 1; next }
        infront && $0 == "---" { infront = 0; next }
        (infront ? "front" : "body") == want { print }
    ' "$2"
}

# Prints the upstream frontmatter with each key the context sets replaced, and
# the context's other keys added at the end.
merge_front() {
    awk -v ctx="$1" -v keys="$FRONTMATTER_KEYS" '
        function keyof(line,   k) {
            if (!match(line, /^[A-Za-z]+:/)) return ""
            k = substr(line, 1, RLENGTH - 1)
            return (k in KEYS) ? k : ""
        }
        BEGIN { n = split(keys, list, " "); for (i = 1; i <= n; i++) KEYS[list[i]] = 1 }
        FILENAME == ctx {
            if ((k = keyof($0)) != "") { cur = k; if (!(k in over)) order[++count] = k }
            if (cur != "") over[cur] = over[cur] $0 "\n"
            next
        }
        {
            if ((k = keyof($0)) != "") cur = k
            seen[cur] = 1
            if (!(cur in over)) print
            else if (!(cur in done)) { printf "%s", over[cur]; done[cur] = 1 }
        }
        END { for (i = 1; i <= count; i++) if (!(order[i] in seen)) printf "%s", over[order[i]] }
    ' "$1" "$2"
}

# Prints the role as the project should hold it: best_practices at <sha>,
# composed with the project's context file for the role if there is one.
compose() {
    local sha="$1" role="$2" ctx="$3/$CONTEXT_DIR/$2.md"
    role_body "$sha" "$role" > "$WORK/role" 2>/dev/null || return 1
    if [[ ! -f "$ctx" ]]; then cat "$WORK/role"; return; fi
    part front "$WORK/role" > "$WORK/up"
    part front "$ctx" > "$WORK/ctx"
    part body "$ctx" | sed '/./,$!d' > "$WORK/ctx-body"
    if grep -q '^name:' "$WORK/ctx"; then
        echo "sync-agents: $ctx can't set name:; the role's name comes from best_practices" >&2
        return 2
    fi
    if [[ -s "$WORK/up" || -s "$WORK/ctx" ]]; then
        echo "---"
        [[ -s "$WORK/up" ]] || echo "name: $role"
        merge_front "$WORK/ctx" "$WORK/up"
        echo "---"
    fi
    part body "$WORK/role"
    if [[ -s "$WORK/ctx-body" ]]; then
        printf '\n<!-- Project specifics, appended by bin/sync-agents from %s. Edit that file and re-sync; never edit this one. -->\n\n' "$CONTEXT_DIR/$role.md"
        cat "$WORK/ctx-body"
    fi
}

resolve() {
    git -C "$ROOT" rev-parse --verify --quiet "$1^{commit}" || {
        echo "sync-agents: unknown ref '$1' in $ROOT" >&2
        exit 1
    }
}

sync() {
    local target="$1" ref="$2" roles="$3"
    local manifest="$target/$AGENTS_DIR/UPSTREAM" sha old_roles role
    sha="$(resolve "$ref")"
    if [[ -z "$roles" && -f "$manifest" ]]; then roles="$(upstream_value "$manifest" roles)"; fi
    if [[ -z "$roles" ]]; then roles="$(roles_at "$sha" | tr '\n' ' ')"; fi
    old_roles=""
    if [[ -f "$manifest" ]]; then old_roles="$(upstream_value "$manifest" roles)"; fi

    mkdir -p "$target/$AGENTS_DIR"
    for role in $roles; do
        compose "$sha" "$role" "$target" > "$WORK/out" || {
            [[ $? -eq 1 ]] && echo "sync-agents: role '$role' does not exist at $sha" >&2
            exit 1
        }
        cp "$WORK/out" "$target/$AGENTS_DIR/$role.md"
    done
    for role in $old_roles; do
        case " $roles " in *" $role "*) ;; *) rm -f "$target/$AGENTS_DIR/$role.md" ;; esac
    done

    printf 'source: %s\nref: %s\nroles: %s\n' "$SOURCE" "$sha" "$(echo $roles)" > "$manifest"
    echo "Synced $(echo $roles | wc -w | tr -d ' ') role(s) from $SOURCE@${sha:0:7} into $target/$AGENTS_DIR"
}

check() {
    local target="$1" manifest="$1/$AGENTS_DIR/UPSTREAM" sha roles role name status=0
    [[ -f "$manifest" ]] || { echo "sync-agents: $manifest not found" >&2; exit 1; }
    sha="$(resolve "$(upstream_value "$manifest" ref)")"
    roles="$(upstream_value "$manifest" roles)"

    for role in $roles; do
        if ! role_body "$sha" "$role" > /dev/null 2>&1; then
            echo "$role: not a role at $SOURCE@${sha:0:7}"
            status=1
        elif ! compose "$sha" "$role" "$target" > "$WORK/out"; then
            status=1
        elif ! cmp -s "$WORK/out" "$target/$AGENTS_DIR/$role.md"; then
            echo "$role: differs from $SOURCE@${sha:0:7} composed with $CONTEXT_DIR/$role.md. Change the role in best_practices, or edit the context file and re-run bin/sync-agents"
            status=1
        fi
    done

    for file in "$target/$AGENTS_DIR"/*.md; do
        [[ -e "$file" ]] || continue
        name="$(basename "$file" .md)"
        case " $roles " in *" $name "*) continue ;; esac
        if roles_at "$sha" | grep -qx "$name"; then
            echo "$name: a project agent can't reuse the shared role name '$name'. Rename it, or add it to roles: and sync"
            status=1
        fi
    done

    [[ $status -eq 0 ]] && echo "Agents match $SOURCE@${sha:0:7}"
    return $status
}

mode="sync" target="" ref="HEAD" roles=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check) mode="check"; shift ;;
        --ref) ref="${2:?--ref needs a value}"; shift 2 ;;
        --roles) roles="${2:?--roles needs a value}"; shift 2 ;;
        -h|--help) usage ;;
        -*) echo "Unknown option: $1" >&2; usage ;;
        *) target="$1"; shift ;;
    esac
done
[[ -n "$target" && -d "$target" ]] || usage

if [[ "$mode" == "check" ]]; then
    check "$target"
else
    sync "$target" "$ref" "$roles"
fi
